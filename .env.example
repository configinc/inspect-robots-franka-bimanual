# Optional authentication for an OpenPI websocket server. Pass it as
# `-P api_key="$OPENPI_API_KEY"` when starting an eval.
OPENPI_API_KEY=

# Provider keys for `--policy agent` (inspect-robots-agent). The CLI loads this
# file; the agent policy picks the key from the `-P model=provider/model` prefix.
# Set only the ones you use. This package never reads them itself.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Works for any model string when a provider key is not set.
OPENROUTER_API_KEY=
